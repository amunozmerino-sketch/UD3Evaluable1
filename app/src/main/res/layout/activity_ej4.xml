<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ej4Activity">
    
    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/verde2"
        android:layout_gravity="top|start"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/verde3"
        android:layout_gravity="top|center"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/verde4"
        android:layout_gravity="top|end"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/morado"
        android:layout_gravity="center|start"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/azul2"
        android:layout_gravity="center|center">

        <Button
            android:id="@+id/volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volver"
            android:layout_gravity="center"
            android:layout_marginVertical="30dp"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/azul3"
        android:layout_gravity="center|end"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/rosa2"
        android:layout_gravity="bottom|start"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/rojillo"
        android:layout_gravity="bottom|center"/>

    <FrameLayout
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:background="@color/carne"
        android:layout_gravity="bottom|end"/>
</FrameLayout>